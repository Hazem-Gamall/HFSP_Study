TARGET javax.crypto.spec.SecretKeySpec

VARS
	java.lang.String keyAlgorithm
	byte[] keyMaterial
	int len
	int offset

CONSTRAINTS
	c1: keyAlgorithm in {"AES", "HmacSHA256", "HmacSHA384", "HmacSHA512"}
	c2: length(keyMaterial) >= offset + len
	c3: neverTypeOf(keyMaterial, "java.lang.String")

METHODS
	m1: SecretKeySpec(keyMaterial, keyAlgorithm)
	m2: SecretKeySpec(keyMaterial, offset, len, keyAlgorithm)
		requires c2
	Ctor := m1 | m2
		requires c1, c3
		requires javax.crypto.SecretKey.preparedKeyMaterial[keyMaterial]
		ensures speccedKey[this, _], generatedKey[this, keyAlgorithm]

FLOW
	Ctor


