TARGET java.security.MessageDigest

VARS
	java.lang.String algorithm
	byte preInputByte
	byte[] preInput
	int preOffset
	int preLen
	java.nio.ByteBuffer preInputByteBuffer
	byte[] input
	int offset
	int len
	byte[] output

CONSTRAINTS
	c1: algorithm in {"SHA-256", "SHA-384", "SHA-512"}
	c2: length(preInput) >= preLen + preOffset && preOffset >= 0 && preLen > 0
	c3: length(output) >= len + offset && offset >= 0 && len > 0
	
METHODS
	g1: getInstance(algorithm)
	g2: getInstance(algorithm, _)
	Get := g1 | g2
		requires c1
		ensures generatedMessageDigest[this]

	u1: update(preInputByte)
	u2: update(preInput)
	u3: update(preInput, preOffset, preLen)
		requires c2
	u4: update(preInputByteBuffer)
	Update := u1 | u2 | u3 | u4

	d1: output = digest()
	d2: output = digest(input)
	d3: digest(output, offset, len)
		requires c3
	DWOU := d2
	    ensures digested[output, input]
	DWU := d1 | d3
	Digest := DWU | DWOU
        ensures digested[output, _]

FLOW
	Get, (DWOU | (Update+, Digest))+